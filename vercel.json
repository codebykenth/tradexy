{
    "version": 2,
    "framework": null,
    "buildCommand": "rm -f public/hot && npm ci && npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3"
        }
    },
    "routes": [
        {
            "src": "/sitemap.xml",
            "dest": "/api/index.php"
        },
        {
            "src": "/manifest.json",
            "dest": "/public/manifest.json"
        },
        {
            "src": "/sw.js",
            "dest": "/public/sw.js",
            "headers": {
                "Service-Worker-Allowed": "/",
                "Cache-Control": "no-cache"
            }
        },
        {
            "src": "/(build|assets|css|js|images|icons|fonts|storage|favicon.ico|robots.txt|ads.txt)(.*)",
            "dest": "/public/$1$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
